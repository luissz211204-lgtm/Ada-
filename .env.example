# ============================================================================
# Ada — Variables de entorno (archivo de ejemplo)
# Copia este archivo como `.env.local` y rellena los valores.
# NUNCA subas el archivo real con secretos al repositorio.
# ============================================================================

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
EV_APP_NAME=Ada

# --- Base de datos ---
# sqlite (local) | libsql (Turso) | postgres (Railway/Render/Neon)
DATABASE_DRIVER=sqlite
EV_DATA_DIR=./data
EV_DB_FILE=ev.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Para libsql (Turso)
# DATABASE_URL=libsql://tu-db.turso.io
# DATABASE_AUTH_TOKEN=tu_token

# Para postgres (Railway/Render/Neon/Supabase)
# DATABASE_URL=postgres://usuario:clave@host:5432/db

# --- Autenticación y cifrado ---
AUTH_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# --- Proveedor de IA (compatible con OpenAI) ---
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_MONTHLY_BUDGET_CENTS=500

# --- Tarea programada del servidor (recordatorios persistentes) ---
CRON_SECRET=
WORKER_INTERVAL_SECONDS=30

# --- Notificaciones por correo (opcional) ---
SMTP_URL=
EMAIL_FROM=

# --- WhatsApp Business Platform (opcional) ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
