# ============================================================================
# Ada — Variables de entorno (archivo de ejemplo)
# Copia este archivo como `.Adalocal` y rellena los valores.
# NUNCA subas el archivo real con secretos al repositorio.
# ============================================================================

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nombre de la aplicación mostrado en la interfaz
EV_APP_NAME=Ada

# --- Base de datos (SQLite local, cero configuración) ---
# Directorio donde se guardan la base de datos y los archivos subidos.
EV_DATA_DIR=./data
EV_DB_FILE=ev.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- Autenticación y cifrado ---
# Obligatorio en producción. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SESSION_TTL_DAYS=30
# Clave de 32 bytes (hex) usada para cifrar secretos de integraciones
# (tokens de WhatsApp, SMTP, etc.) guardados en la base de datos.
ENCRYPTION_KEY=

# --- Proveedor de IA (compatible con la API de OpenAI) ---
# Puede ser OpenAI, Groq, Together, LM Studio local, Ollama (modo compatible), etc.
# IMPORTANTE: una suscripción de ChatGPT NO incluye acceso a esta API.
# Debes obtener una API key aparte en el panel del proveedor elegido.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
# Presupuesto mensual máximo de IA en centavos de USD (protección de costes)
AI_MONTHLY_BUDGET_CENTS=500

# --- Tarea programada del servidor (recordatorios persistentes) ---
# Secreto compartido con el cron externo (Vercel Cron u otro).
# Debe coincidir con la cabecera `x-ev-cron-secret`.
CRON_SECRET=
# Intervalo del worker local en segundos
WORKER_INTERVAL_SECONDS=30

# --- Notificaciones por correo (opcional) ---
# SMTP con autenticación, p. ej. smtp://usuario:clave@smtp.servidor.com:587
SMTP_URL=
EMAIL_FROM=

# --- WhatsApp Business Platform (opcional, fase 6) ---
# Meta WhatsApp Business Cloud API o proveedor compatible (Twilio, etc.)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
